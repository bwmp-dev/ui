---
import { DiscordIcon, GitHubIcon } from '@stack/icons'
import { SITE } from '~/content/site'

const year = new Date().getFullYear()

const columns = [
  {
    title: 'Product',
    links: [
      { href: '#features', label: 'Features' },
      { href: '#screenshots', label: 'Screenshots' },
      { href: '#install', label: 'Install' },
      { href: '#faq', label: 'FAQ' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: SITE.github, label: 'Source' },
      { href: `${SITE.github}/releases`, label: 'Releases' },
      { href: `${SITE.github}/issues`, label: 'Issues' },
      { href: `${SITE.github}/blob/main/LICENSE`, label: 'Licence' },
    ],
  },
]
---

<footer class="border-line mt-8 border-t px-6 py-12">
  <div class="mx-auto flex max-w-page flex-col gap-10 sm:flex-row sm:justify-between">
    <div class="max-w-sm">
      <p class="text-fg flex items-center gap-2 font-semibold">
        <span
          class="bg-accent text-accent-fg grid size-6 place-items-center rounded-md text-xs font-bold"
        >
          {SITE.name.slice(0, 1)}
        </span>
        {SITE.name}
      </p>
      <p class="text-fg-muted mt-3 text-sm">{SITE.tagline}</p>
      <div class="mt-4 flex items-center gap-2">
        <a
          href={SITE.github}
          rel="noreferrer"
          aria-label="GitHub"
          class="text-fg-muted hover:text-fg focus-ring rounded-sm p-1"
        >
          <GitHubIcon size={18} />
        </a>
        <a
          href={SITE.discord}
          rel="noreferrer"
          aria-label="Discord"
          class="text-fg-muted hover:text-fg focus-ring rounded-sm p-1"
        >
          <DiscordIcon size={18} />
        </a>
      </div>
    </div>

    <div class="flex gap-12">
      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <p class="text-fg text-sm font-semibold">{column.title}</p>
            <ul class="mt-3 flex flex-col gap-2">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-fg-muted hover:text-fg focus-ring rounded-sm text-sm"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <p class="text-fg-subtle mx-auto mt-10 max-w-page text-xs">
    © {year} {SITE.name} contributors. Apache 2.0 licensed.
  </p>
</footer>
