---
import { NAV, SITE } from '~/content/site'

/**
 * The narrow-screen menu, built on the native `<dialog>` element.
 *
 * `showModal()` supplies focus trapping, Escape-to-close, an inert background
 * and a `::backdrop` — the whole reason a Drawer component exists. Using it
 * here keeps the header at zero framework JavaScript.
 */
---

<button
  type="button"
  id="mobile-nav-open"
  aria-label="Open menu"
  class="text-fg-muted hover:text-fg hover:bg-hover focus-ring transition-control grid size-control-md place-items-center rounded-md md:hidden"
>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
    <path d="M3 6h18M3 12h18M3 18h18"></path>
  </svg>
</button>

<dialog
  id="mobile-nav"
  aria-label="Menu"
  class="bg-surface-raised text-fg border-line m-0 ml-auto h-dvh w-[min(20rem,85vw)] max-w-none border-l p-0 backdrop:bg-overlay"
>
  <div class="border-line-muted flex h-14 items-center justify-between border-b px-4">
    <span class="font-semibold">{SITE.name}</span>
    <button
      type="button"
      id="mobile-nav-close"
      aria-label="Close menu"
      class="text-fg-muted hover:text-fg hover:bg-hover focus-ring grid size-control-md place-items-center rounded-md"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav aria-label="Mobile" class="flex flex-col p-3">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          data-close
          class="text-fg hover:bg-hover focus-ring rounded-md px-3 py-2.5 text-lg"
        >
          {item.label}
        </a>
      ))
    }
    <a href={SITE.github} rel="noreferrer" class="text-fg hover:bg-hover focus-ring rounded-md px-3 py-2.5 text-lg">
      GitHub
    </a>
  </nav>
</dialog>

<script>
  const dialog = document.getElementById('mobile-nav') as HTMLDialogElement | null
  if (dialog) {
    document.getElementById('mobile-nav-open')?.addEventListener('click', () => dialog.showModal())
    document.getElementById('mobile-nav-close')?.addEventListener('click', () => dialog.close())

    // Following an in-page anchor has to close the dialog too.
    for (const link of dialog.querySelectorAll('[data-close]')) {
      link.addEventListener('click', () => dialog.close())
    }

    // The backdrop is part of the dialog's own box, so compare the click point.
    dialog.addEventListener('click', (event) => {
      const box = dialog.getBoundingClientRect()
      const inside =
        event.clientX >= box.left &&
        event.clientX <= box.right &&
        event.clientY >= box.top &&
        event.clientY <= box.bottom
      if (!inside) dialog.close()
    })
  }
</script>
