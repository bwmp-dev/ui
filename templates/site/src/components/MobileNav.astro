---
import { NAV, SITE } from '~/content/site'

/**
 * The narrow-screen menu, built on the native `<dialog>` element.
 *
 * `showModal()` supplies focus trapping, Escape-to-close, an inert background
 * and a `::backdrop` — the whole reason a Drawer component exists. Using it
 * here keeps the header at zero framework JavaScript.
 */
---

<button
  type="button"
  id="mobile-nav-open"
  aria-label="Open menu"
  class="grid size-control-md place-items-center rounded-md text-fg-muted focus-ring transition-control hover:bg-hover hover:text-fg md:hidden"
>
  <svg
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M3 6h18M3 12h18M3 18h18"></path>
  </svg>
</button>

<dialog
  id="mobile-nav"
  aria-label="Menu"
  class="m-0 ml-auto h-dvh w-[min(20rem,85vw)] max-w-none border-l border-line bg-surface-raised p-0 text-fg backdrop:bg-overlay"
>
  <div class="flex h-14 items-center justify-between border-b border-line-muted px-4">
    <span class="font-semibold">{SITE.name}</span>
    <button
      type="button"
      id="mobile-nav-close"
      aria-label="Close menu"
      class="grid size-control-md place-items-center rounded-md text-fg-muted focus-ring hover:bg-hover hover:text-fg"
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav aria-label="Mobile" class="flex flex-col p-3">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          data-close
          class="rounded-md px-3 py-2.5 text-lg text-fg focus-ring hover:bg-hover"
        >
          {item.label}
        </a>
      ))
    }
    <a
      href={SITE.github}
      rel="noreferrer"
      class="rounded-md px-3 py-2.5 text-lg text-fg focus-ring hover:bg-hover"
    >
      GitHub
    </a>
  </nav>
</dialog>

<script>
  const dialog = document.getElementById('mobile-nav') as HTMLDialogElement | null
  if (dialog) {
    document.getElementById('mobile-nav-open')?.addEventListener('click', () => dialog.showModal())
    document.getElementById('mobile-nav-close')?.addEventListener('click', () => dialog.close())

    // Following an in-page anchor has to close the dialog too.
    for (const link of dialog.querySelectorAll('[data-close]')) {
      link.addEventListener('click', () => dialog.close())
    }

    // The backdrop is part of the dialog's own box, so compare the click point.
    dialog.addEventListener('click', (event) => {
      const box = dialog.getBoundingClientRect()
      const inside =
        event.clientX >= box.left &&
        event.clientX <= box.right &&
        event.clientY >= box.top &&
        event.clientY <= box.bottom
      if (!inside) dialog.close()
    })
  }
</script>
