---
import { GitHubIcon } from '@bwmp-dev/icons'
import ThemeToggle from './ThemeToggle.astro'
import MobileNav from './MobileNav.astro'
import { NAV, SITE } from '~/content/site'
---

<header
  class="sticky top-0 z-40 border-b border-line bg-canvas/85 backdrop-blur-sm supports-[backdrop-filter]:bg-canvas/70"
>
  <div class="mx-auto flex h-14 max-w-page items-center gap-4 px-6">
    <a href="/" class="flex items-center gap-2 rounded-sm font-semibold text-fg focus-ring">
      <span
        class="grid size-6 place-items-center rounded-md bg-accent text-xs font-bold text-accent-fg"
      >
        {SITE.name.slice(0, 1)}
      </span>
      {SITE.name}
    </a>

    <nav aria-label="Main" class="ml-4 hidden items-center gap-1 md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-2.5 py-1.5 text-sm font-medium text-fg-muted focus-ring transition-control hover:bg-hover hover:text-fg"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-1 items-center justify-end gap-1">
      <a
        href={SITE.github}
        rel="noreferrer"
        aria-label={`${SITE.name} on GitHub`}
        class="grid size-control-md place-items-center rounded-md text-fg-muted focus-ring hover:bg-hover hover:text-fg"
      >
        <GitHubIcon size={16} />
      </a>
      {
        /*
        Both are plain Astro with a few lines of inline script. The header ships
        no framework code at all; the only island on this page is the gallery,
        which genuinely needs state and hydrates on `visible`.
      */
      }
      <ThemeToggle />
      <MobileNav />
    </div>
  </div>
</header>
