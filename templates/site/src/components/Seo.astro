---
import { SITE } from '~/content/site'

/**
 * Every tag a project site actually needs, in one place.
 *
 * Pages pass only what differs. Absolute URLs are derived from `Astro.site`,
 * because relative og:image values are ignored by most crawlers.
 */
interface Props {
  title?: string
  description?: string
  /** Path or absolute URL of the social image. */
  image?: string
  /** Set on pages that should not be indexed. */
  noindex?: boolean
}

const { title, description = SITE.description, image = SITE.ogImage, noindex = false } = Astro.props

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url)
const socialImage = new URL(image, Astro.site ?? SITE.url)
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={SITE.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
