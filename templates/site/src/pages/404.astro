---
import BaseLayout from '~/layouts/BaseLayout.astro'
import { LinkButton } from '@stack/ui'
import { SITE } from '~/content/site'
---

<BaseLayout title="Page not found" noindex>
  <div class="grid min-h-[60dvh] place-items-center px-6 py-20">
    <div class="flex max-w-narrow flex-col items-center text-center">
      <p class="text-fg-subtle font-mono text-xs tracking-widest uppercase">Error 404</p>
      <h1 class="text-fg mt-3 text-3xl font-semibold tracking-tight">Page not found</h1>
      <p class="text-fg-muted mt-3">
        That page does not exist. It may have moved, or the link that brought you here may be out of
        date.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <LinkButton href="/" variant="primary">Back to the homepage</LinkButton>
        <LinkButton href={`${SITE.github}/issues`} rel="noreferrer">Report a broken link</LinkButton>
      </div>
    </div>
  </div>
</BaseLayout>
