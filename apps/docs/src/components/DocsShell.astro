---
import { NAVIGATION, siblingsOf } from '~/lib/navigation'
import ThemeControls from './ThemeControls.astro'
import '~/styles.css'

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
const current = Astro.url.pathname.replace(/\/$/, '') || '/'
const { previous, next } = siblingsOf(current)
---

<!doctype html>
<html lang="en" data-appearance="dark" data-density="comfortable">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Stack</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      ;(function () {
        try {
          var p = JSON.parse(localStorage.getItem('stack:docs') || '{}')
          var a = p.appearance || 'dark'
          if (a === 'system')
            a = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          var e = document.documentElement
          e.setAttribute('data-appearance', a)
          e.setAttribute('data-density', p.density || 'comfortable')
          if (p.theme && p.theme !== 'default') e.setAttribute('data-theme', p.theme)
        } catch (_) {}
      })()
    </script>
  </head>

  <body class="bg-canvas text-fg">
    <a
      href="#content"
      class="sr-only rounded-md border border-line bg-surface-raised px-3 py-2 focus-ring focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>

    <header
      class="sticky top-0 z-40 border-b border-line bg-canvas/85 backdrop-blur-sm supports-[backdrop-filter]:bg-canvas/70"
    >
      <div class="mx-auto flex h-14 max-w-[90rem] items-center gap-3 px-5">
        <a href="/" class="flex items-center gap-2 rounded-sm font-semibold text-fg focus-ring">
          <span
            class="grid size-6 place-items-center rounded-md bg-accent text-xs font-bold text-accent-fg"
          >
            S
          </span>
          Stack
        </a>
        <span class="hidden text-xs text-fg-subtle sm:inline">
          Design system and project templates
        </span>
        <div class="flex-1"></div>
        <ThemeControls />
      </div>
    </header>

    <div class="mx-auto flex max-w-[90rem] gap-10 px-5">
      <nav
        aria-label="Documentation"
        class="sticky top-14 hidden h-[calc(100dvh-3.5rem)] w-56 shrink-0 overflow-y-auto py-8 lg:block"
      >
        {
          NAVIGATION.map((section) => (
            <div class="mb-6">
              <p class="mb-2 text-2xs font-medium tracking-wide text-fg-subtle uppercase">
                {section.title}
              </p>
              <ul class="flex flex-col gap-0.5">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={link.href === current ? 'page' : undefined}
                      class="block rounded-md px-2 py-1 text-sm text-fg-muted focus-ring hover:bg-hover hover:text-fg aria-[current=page]:bg-selected aria-[current=page]:text-fg"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <main id="content" class="min-w-0 flex-1 py-10">
        <article class="prose">
          <h1 class="text-3xl font-semibold tracking-tight text-fg">{title}</h1>
          {description && <p class="mt-2 text-lg text-fg-muted">{description}</p>}
          <slot />
        </article>

        {
          (previous || next) && (
            <nav
              aria-label="Pagination"
              class="mt-16 flex items-stretch justify-between gap-4 border-t border-line pt-6"
            >
              {previous ? (
                <a
                  href={previous.href}
                  class="flex-1 rounded-md border border-line px-4 py-3 focus-ring hover:border-line-strong hover:bg-hover"
                >
                  <span class="block text-2xs text-fg-subtle">Previous</span>
                  <span class="block text-sm font-medium text-fg">{previous.label}</span>
                </a>
              ) : (
                <span class="flex-1" />
              )}
              {next ? (
                <a
                  href={next.href}
                  class="flex-1 rounded-md border border-line px-4 py-3 text-right focus-ring hover:border-line-strong hover:bg-hover"
                >
                  <span class="block text-2xs text-fg-subtle">Next</span>
                  <span class="block text-sm font-medium text-fg">{next.label}</span>
                </a>
              ) : (
                <span class="flex-1" />
              )}
            </nav>
          )
        }
      </main>
    </div>
  </body>
</html>
