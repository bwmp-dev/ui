---
import DocsShell from '~/components/DocsShell.astro'
import Preview from '~/components/Preview.astro'
import PropsTable from '~/components/PropsTable.astro'
import NavigationDemo from '~/demos/navigation-demo'

const routerExample = `<Sidebar.Item
  icon={Server}
  render={<Link to="/devices" activeProps={{ 'data-active': 'true' }} />}
>
  Devices
</Sidebar.Item>`
---

<DocsShell
  title="Navigation"
  description="Tabs, breadcrumbs, pagination and the app's navigation rails."
>
  <Preview demo="navigation-demo" title="Tabs, breadcrumbs and pagination" contained={false}>
    <NavigationDemo client:visible />
  </Preview>

  <h2 id="tabs">Tabs</h2>
  <p>
    Tabs switch between views of the same subject. They are not navigation: if each tab is a
    distinct URL, use links, so history and middle-click behave the way people expect.
  </p>
  <PropsTable type="TabsListProps" element="div" />

  <h2 id="sidebar">Sidebar and Navbar</h2>
  <p>
    Both are layout shells rather than routers. Links are plain anchors, and any routing library is
    composed in through <code>render</code>:
  </p>
  <pre><code>{routerExample}</code></pre>
  <p>
    Let the router decide what is active. Comparing paths by hand gets nested routes and trailing
    slashes wrong.
  </p>
  <PropsTable type="SidebarItemProps" element="a" />

  <h2 id="pagination">Pagination</h2>
  <p>
    Zero-based, to line up with TanStack Table's <code>pageIndex</code>. The number of slots stays
    constant as you page, so the control does not reflow under the cursor.
  </p>
  <PropsTable type="PaginationProps" />
</DocsShell>
