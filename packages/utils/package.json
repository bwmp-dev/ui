{
  "name": "@bwmp-dev/utils",
  "version": "0.0.0",
  "description": "Small framework-independent helpers shared across the stack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bwmp-dev/ui.git",
    "directory": "packages/utils"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@bwmp-dev/tokens": "workspace:*",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@bwmp-dev/eslint-config": "workspace:*",
    "@bwmp-dev/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "rimraf": "^6.1.2",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
