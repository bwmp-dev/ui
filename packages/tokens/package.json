{
  "name": "@bwmp-dev/tokens",
  "version": "0.1.0",
  "description": "Framework-agnostic design tokens as CSS custom properties.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bwmp-dev/ui.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./theme.css": "./src/theme.css",
    "./themes/brands.css": "./src/themes/brands.css",
    "./tailwind-intellisense.css": "./src/tailwind-intellisense.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./tokens.css": "./src/tokens.css",
      "./theme.css": "./src/theme.css",
      "./themes/brands.css": "./src/themes/brands.css",
      "./tailwind-intellisense.css": "./src/tailwind-intellisense.css"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@bwmp-dev/eslint-config": "workspace:*",
    "@bwmp-dev/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "rimraf": "^6.1.2",
    "tailwindcss": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
