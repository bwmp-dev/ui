{
  "name": "@bwmp-dev/hooks",
  "version": "0.1.0",
  "description": "Reusable React hooks with no design-system coupling.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@bwmp-dev/eslint-config": "workspace:*",
    "@bwmp-dev/tsconfig": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "^6.1.2",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@testing-library/jest-dom": "catalog:"
  }
}
