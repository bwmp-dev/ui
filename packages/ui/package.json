{
  "name": "@bwmp-dev/ui",
  "version": "0.1.0",
  "description": "The shared React component system.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./table": "./src/table/index.ts",
    "./form": "./src/form/index.tsx",
    "./styles.css": "./styles.css"
  },
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./table": {
        "types": "./dist/table.d.mts",
        "default": "./dist/table.mjs"
      },
      "./form": {
        "types": "./dist/form.d.mts",
        "default": "./dist/form.mjs"
      },
      "./styles.css": "./styles.css"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@bwmp-dev/hooks": "workspace:*",
    "@bwmp-dev/icons": "workspace:*",
    "@bwmp-dev/tokens": "workspace:*",
    "@bwmp-dev/utils": "workspace:*",
    "lucide-react": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-table": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    },
    "@tanstack/react-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bwmp-dev/eslint-config": "workspace:*",
    "@bwmp-dev/tsconfig": "workspace:*",
    "@tailwindcss/cli": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "^6.1.2",
    "tailwindcss": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
