{
  "name": "stack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "docs": "turbo run dev --filter=@stack/docs",
    "playground": "turbo run dev --filter=@stack/playground",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,mdx,astro,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,mdx,astro,yaml,yml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build --filter='./packages/*' && changeset publish",
    "stack": "node tooling/create-stack/bin/stack.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@stack/config-eslint": "workspace:*",
    "@stack/config-typescript": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "rimraf": "^6.1.2",
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "prettier-plugin-astro": "catalog:"
  }
}